{
  "name": "editawr",
  "version": "0.1.0",
  "description": "EditAWr \u00e2\u20ac\u201d RAW-first photo organizer and editor (SD import, NEF, GPU denoise, sharpening)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/vendor.js && electron .",
    "dev": "node scripts/vendor.js && electron . --dev",
    "test": "node --test",
    "test:e2e": "node scripts/vendor.js && electron scripts/e2e-app.js",
    "vendor": "node scripts/vendor.js",
    "postinstall": "node scripts/vendor.js",
    "pack": "node scripts/vendor.js && electron-builder --dir",
    "dist": "node scripts/vendor.js && electron-builder"
  },
  "keywords": [
    "electron",
    "raw",
    "nef",
    "photo",
    "denoise",
    "lightroom"
  ],
  "license": "MIT",
  "dependencies": {
    "exifr": "^7.1.3",
    "libraw-wasm": "^1.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "author": "EditAWr contributors",
  "engines": {
    "node": ">=22.12.0"
  }
}
